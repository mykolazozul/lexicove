# Copy this file to .env.local and fill in your own Supabase project.
# Both values are public by design (they ship to every browser); access is controlled
# by Row Level Security in the database. Never put a service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
