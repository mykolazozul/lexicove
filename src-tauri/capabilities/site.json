{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "The live website inside the app's windows. Only this exact address gets the desktop functions; any other page gets none.",
  "windows": ["main", "card"],
  "remote": { "urls": ["https://lexicove.vercel.app/*"] },
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-show-card",
    "allow-hide-card",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-set-hotkey",
    "allow-user-busy"
  ]
}
